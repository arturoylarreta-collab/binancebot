# ── Environment ────────────────────────────────────────────────────────────────
APP_ENV=dev
# market_data / backtest / paper / live
RUN_MODE=paper
LIVE_TRADING_ENABLED=false

# ── Binance Futures REST (USDⓈ-M) ──────────────────────────────────────────────
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/stream

# ── Credentials (dev only — never commit real keys) ─────────────────────────────
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# ── Universe ────────────────────────────────────────────────────────────────────
UNIVERSE_MAX_SYMBOLS=100
UNIVERSE_MIN_QUOTE_VOLUME_24H=5000000
UNIVERSE_MAX_SPREAD_PCT=0.0015

# ── Limits / backpressure ──────────────────────────────────────────────────────
WS_EVENT_QUEUE_MAXSIZE=100000
WS_BATCH_SIZE=20
WS_CONN_TIMEOUT_S=30
WS_PING_INTERVAL_S=20
WS_RECV_TIMEOUT_S=45
WS_RECONNECT_BASE_S=1.0
WS_RECONNECT_MAX_S=30.0
WS_RECONNECT_FACTOR=2.0

# ── Order book ──────────────────────────────────────────────────────────────────
ORDERBOOK_SNAPSHOT_LIMIT=100

# ── Features ────────────────────────────────────────────────────────────────────
FEATURE_INTERVAL_S=1.0
ROLLING_HISTORY_SIZE=120

# ── Strategy / Signal Engine (FASE 3) ─────────────────────────────────────────
# Master switch: when false the Signal Engine reports signals but they are
# never eligible (no trading in FASE 3 anyway).
STRATEGY_ENABLED=false
# JSON weights for the 8 dimensions: trend, momentum, volume, order_book,
# volatility, price_structure, news, ml. Must sum to 1.0 (validated).
# SIGNAL_WEIGHTS_JSON={"trend":0.2,"momentum":0.2,"volume":0.15,"order_book":0.15,"volatility":0.1,"price_structure":0.1,"news":0.05,"ml":0.05}
# Regime gating: comma-separated lowercase regimes. Empty = all allowed.
# STRATEGY_ALLOWED_REGIMES=trending_up,range
STRATEGY_LONG_THRESHOLD=60
STRATEGY_SHORT_THRESHOLD=40

# ── Risk defaults (validated in FASE 5, wired to Settings.risk in FASE 7) ─────
RISK_MAX_RISK_PER_TRADE_PCT=0.01
RISK_MAX_TOTAL_OPEN_RISK_PCT=0.03
RISK_MAX_POSITIONS=10
RISK_MAX_LEVERAGE=1
RISK_DAILY_LOSS_LIMIT_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_CORRELATED_GROUP_CAP_PCT=0.06

# ── Execution (FASE 6) ──────────────────────────────────────────────────────────
EXECUTION_RETRIES=2
EXECUTION_BACKOFF_BASE_S=0.5
EXECUTION_BACKOFF_MAX_S=5.0
EXECUTION_SUBMIT_TIMEOUT_S=5.0
EXECUTION_FILL_TIMEOUT_S=10.0
EXECUTION_PROTECTION_TIMEOUT_S=10.0
EXECUTION_SLIPPAGE_PCT=0.0005
EXECUTION_EVENT_QUEUE_SIZE=1000
EXECUTION_DEFAULT_RR_RATIO=2.0
EXECUTION_DEFAULT_SL_ATR_MULT=1.5

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=kv
LOG_DIR=logs

# ── Paper trading (FASE 7) ──────────────────────────────────────────────────────
PAPER_START_EQUITY=10000
PAPER_FEE_PCT=0.0004
# Seconds between internal-vs-venue reconciliation passes (0 disables... use > 0).
PAPER_RECONCILE_INTERVAL_S=60
# Seconds between periodic equity summaries in the run loop (0 disables).
PAPER_SUMMARY_INTERVAL_S=30
# Never open a second position on an already-open symbol.
PAPER_MAX_OPEN_PER_SYMBOL=1
# SQLite audit trail location (relative to project root).
PAPER_DB_PATH=logs/paper.db

# ── Backtesting (FASE 8) ────────────────────────────────────────────────────────
# Directory where per-symbol historical kline CSVs are stored/downloaded.
BACKTEST_DATA_DIR=data/klines
# Kline interval in seconds: 1/60/180/300/900/1800/3600/14400/86400.
BACKTEST_INTERVAL_S=60
# Bars of warm-up before any decision is emitted (EMA50/ADX compatibility).
BACKTEST_WARMUP_BARS=60
# Execution policy: "close" (fill at decision-bar close) | "next_open".
BACKTEST_FILL_AT=close
BACKTEST_START_EQUITY=10000
BACKTEST_MAX_OPEN_PER_SYMBOL=1
# Deterministic partial entry fills (0 < fraction <= 1): models bad-latency entries.
BACKTEST_ENTRY_FILL_FRACTION=1.0
# When true, trades failing expected_edge - costs >= COST_MIN_EDGE_PCT are blocked.
BACKTEST_ENFORCE_EDGE_GATE=false
# Optional SQLite audit trail for the backtest (empty = noop in-memory).
BACKTEST_DB_PATH=

# ── Cost model (FASE 8) ────────────────────────────────────────────────────────
# fee/spread/latency/funding are attributed on top of gross PnL; slippage is
# already embedded in fill prices by the bar venue (no double counting).
COST_FEE_PCT=0.0004
COST_SPREAD_PCT=0.0001
COST_SLIPPAGE_PCT=0.0005
COST_LATENCY_PCT=0.0001
COST_FUNDING_PCT_PER_8H=0.0001
COST_MIN_EDGE_PCT=0.0015

# ── Observability (FASE 8.5) ──────────────────────────────────────────────────
# Telegram alerts (fire-and-forget). JAMAS pongas el token real aqui: solo en
# tu .env local (`.env` y `.env.*` estan ignorados por git).
# Crea un bot con @BotFather y copia su token; el chat_id se obtiene al enviar
# /start al bot y luego consultar getUpdates (o activando la alerta).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Master switch de las alertas Telegram (HTTPS hacia api.telegram.org).
MONITORING_TELEGRAM_ENABLED=false
MONITORING_HTTP_TIMEOUT_S=5.0
MONITORING_QUEUE_SIZE=256
# Cada cuantos segundos se persiste un heartbeat con equity/drawdown.
MONITORING_HEARTBEAT_INTERVAL_S=5.0
# Cooldown (s) para no spamear el mismo halt de riesgo.
MONITORING_ALERT_COOLDOWN_S=300
# SQLite que lee el dashboard (streamlit run crypto_scalper/dashboard/app.py).
DASHBOARD_DB_PATH=logs/paper.db